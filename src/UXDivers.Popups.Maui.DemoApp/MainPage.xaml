<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UXDivers.Popups.Maui.DemoApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UXDivers.Popups.Maui.DemoApp"
    BackgroundColor="{DynamicResource BackgroundColor}">
    <ScrollView VerticalScrollBarVisibility="Never">
        <!--  Main Container  -->
        <VerticalStackLayout
            Margin="{DynamicResource AirSpacing}"
            Spacing="{DynamicResource SpacingBig}"
            VerticalOptions="Fill">
            <!--  Title  -->
            <VerticalStackLayout>
                <Label Style="{DynamicResource MainTitleStyle}" Text="Pop-up Library" />
                <Label Style="{DynamicResource MainSubTitleStyle}" Text="Try all our Free .NET MAUI Pop-ups flavors." />
            </VerticalStackLayout>
            <!--  Cards Container  -->
            <FlexLayout
                x:Name="flexCardContainer"
                Margin="{OnIdiom Phone=-4,
                                 Tablet=-8,
                                 Desktop=-8}"
                Wrap="Wrap">
                <!--  Simple Text  -->
                <Border Style="{DynamicResource MainCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSimpleTextTapped" />
                    </Border.GestureRecognizers>
                    <Grid Style="{DynamicResource MainCardContentGridStyle}">
                        <Label
                            Style="{DynamicResource CardIconStyle}"
                            Text="{x:Static local:MaterialSymbolsFont.Brand_family}"
                            TextColor="{DynamicResource IconGreen}" />
                        <Label
                            Grid.Row="1"
                            Style="{DynamicResource CardTitleStyle}"
                            Text="Reproduction Popup" />
                        <Label
                            Grid.Row="2"
                            Style="{DynamicResource CardSubTitleStyle}"
                            Text="Minimal message for short, clear notes." />
                    </Grid>
                </Border>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
